{
  "schemaVersion": 8,
  "app": {
    "name": "Bloom",
    "platform": "mobile-web-pwa",
    "localFirst": true,
    "dateFormat": "dd/mm/yyyy",
    "timeFormat": "HH:mm",
    "forbiddenUserFacingTerms": ["low-energy", "quick", "deep"]
  },
  "navigation": ["today", "check-in", "cycle", "history", "patterns"],
  "dailyFlow": {
    "firstOpen": ["compact-baseline-sheet"],
    "dailyStateOptions": ["Good", "Okay", "Bad"],
    "badRoute": "support-now",
    "repeatDailyState": false,
    "medicationSetupMayBeDeferred": true,
    "sleepTimesOptional": true
  },
  "home": {
    "primaryAction": "CHECK IN",
    "primaryVisual": "growing-lotus",
    "lotusProgression": "time-of-day-only",
    "medicationPlacement": "immediately-below-primary-action",
    "visualTriggerVisibleLabels": true,
    "visualTriggerOrder": "most-used-first",
    "visualTriggerBehaviour": {
      "tapOpensCapture": true,
      "saveRequiresPrimaryAnswer": true,
      "recordedTodayIndicator": true,
      "notesOptional": true,
      "secondaryDetailsCollapsed": true,
      "repeatEntriesAllowed": true,
      "saveFeedback": "close-tick-toast-with-undo"
    },
    "visualTriggers": [
      {"key": "nap", "label": "Sleep", "asset": "assets/triggers/sleep.png"},
      {"key": "caffeine", "label": "Caffeinate", "asset": "assets/triggers/caffeinate.png"},
      {"key": "alcohol", "label": "Alcohol", "asset": "assets/triggers/alcohol.png"},
      {"key": "breathing", "label": "Breathe", "asset": "assets/triggers/breathe.png"},
      {"key": "water", "label": "Hydrate", "asset": "assets/triggers/hydrate.png"},
      {"key": "sensory-overload", "label": "Sense", "asset": "assets/triggers/sense.png"}
    ],
    "legacyEventKeys": ["nap", "caffeine", "alcohol", "breathing", "water", "sensory-overload"],
    "healthPresentation": "supporting-context-not-primary-card",
    "sevenDayRibbon": true,
    "homeSections": {
      "display": "manual-accordions",
      "settingsCanHideAndReorder": true
    }
  },
  "periodicCheckInGroups": [
    "How I feel",
    "How my brain is working",
    "What my body is doing",
    "Sensory overload",
    "Context & triggers",
    "Regulation",
    "Needs / what would help",
    "Nothing major / just logging"
  ],
  "medications": {
    "model": "time-of-day-adherence-and-access",
    "effectTracking": false,
    "responses": ["Yes", "No", "I don't remember"],
    "whyNot": ["Forgot", "Ran out", "Chose not to", "Side effects", "Couldn't access it", "Unavailable / out of stock", "Other"]
  },
  "appleHealth": {
    "bridgeFile": "latest.json",
    "fields": ["capturedAt", "steps", "restingHeartRate", "heartRateMin", "heartRateMax", "heartRateAverage", "hrv", "respiratoryRate"],
    "sleepDeferred": true,
    "missingValuePolicy": "empty-string-or-null-means-unavailable",
    "refresh": "attempt-on-open-with-visible-last-success-and-manual-retry"
  },
  "history": {
    "opensWithCategoryFilters": true,
    "categories": ["mood", "medication", "cycle", "triggers"],
    "correctionModel": "immediate-undo-only"
  },
  "patterns": {
    "primaryView": "relationship-cards",
    "showEmergingEarly": true,
    "includeEvidenceCounts": true,
    "causalityClaims": false
  },
  "privacy": {
    "storage": "localStorage",
    "healthDataInUrl": false,
    "remoteHealthDatabase": false,
    "hosting": "private-authenticated-site"
  }
}
